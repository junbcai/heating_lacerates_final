## Table S14: Natural lacerate production by 2-week interval
s5a_by_cohort <- lacerates_per_tub %>%
group_by(cohort) %>%
group_modify(~ {
mod <- lm(n_lacerates ~ temp, data = .x)
pairs(
emmeans(mod, ~ temp),
adjust = "sidak"
) %>%
as.data.frame()
}) %>%
ungroup() %>%
select(
cohort,
contrast,
estimate,
SE,
df,
