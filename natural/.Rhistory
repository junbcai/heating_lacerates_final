)
) +
labs(
x = "Temperature",
y = "Mean symbiont area",
color = "Temperature"
) +
my_theme +
theme(
axis.text.x = element_text(
angle = 0,
hjust = 0.5,
vjust = 0.5
),
legend.position = "none"
)
# =========================================================
# =========================================================
# SECTION 5. EXACT P-VALUES + BRACKETS
# =========================================================
# =========================================================
# ---------------------------------------------------------
# 5.1 Helper function for exact p-value labels
# ---------------------------------------------------------
format_exact_p <- function(p) {
case_when(
is.na(p) ~ "p = NA",
p < 0.0001 ~ "p < 0.0001",
TRUE ~ paste0(
"p = ",
formatC(
p,
format = "f",
digits = 4
)
)
)
}
# =========================================================
# PANEL A — NATURAL LACERATES PER TUB
# =========================================================
# ---------------------------------------------------------
# 5.2 Within-cohort p-values
# ---------------------------------------------------------
pvals_lacerates <- lacerates_per_tub %>%
group_by(cohort) %>%
group_modify(~ {
dat <- .x
mod <- lm(
n_lacerates ~ temp,
data = dat
)
em <- emmeans(
mod,
~ temp
)
contrast_result <- pairs(
em,
adjust = "sidak"
) %>%
as.data.frame()
tibble(
p.value = contrast_result$p.value[1]
)
}) %>%
ungroup()
# ---------------------------------------------------------
# 5.3 Bracket positions
# ---------------------------------------------------------
pvals_lacerates <- pvals_lacerates %>%
left_join(
lacerates_per_tub %>%
group_by(cohort) %>%
summarise(
max_y = max(
n_lacerates,
na.rm = TRUE
),
.groups = "drop"
),
by = "cohort"
) %>%
mutate(
y_bracket = max_y + 5,
y_text = max_y + 8,
p_label = format_exact_p(
p.value
)
)
# ---------------------------------------------------------
# 5.4 Panel A — exact p-values
# ---------------------------------------------------------
p_lacerates_tub_p <- ggplot(
lacerates_per_tub,
aes(
x = treatment,
y = n_lacerates,
color = treatment
)
) +
geom_boxplot(
width = 0.58,
fill = NA,
linewidth = 1.2,
outlier.shape = NA
) +
geom_jitter(
width = 0.14,
height = 0.05,
size = 2.8,
alpha = 0.65,
stroke = 0.9
) +
geom_segment(
data = pvals_lacerates,
aes(
x = 1,
xend = 2,
y = y_bracket,
yend = y_bracket
),
inherit.aes = FALSE,
color = "black",
linewidth = 0.7
) +
geom_segment(
data = pvals_lacerates,
aes(
x = 1,
xend = 1,
y = y_bracket,
yend = y_bracket - 1.5
),
inherit.aes = FALSE,
color = "black",
linewidth = 0.7
) +
geom_segment(
data = pvals_lacerates,
aes(
x = 2,
xend = 2,
y = y_bracket,
yend = y_bracket - 1.5
),
inherit.aes = FALSE,
color = "black",
linewidth = 0.7
) +
geom_text(
data = pvals_lacerates,
aes(
x = 1.5,
y = y_text,
label = p_label
),
inherit.aes = FALSE,
color = "black",
size = 4.2
) +
facet_wrap(
~ cohort,
nrow = 1,
ncol = 5,
labeller = labeller(cohort = cohort_labels)
) +
coord_cartesian(
ylim = c(0, 85),
clip = "off"
) +
scale_color_manual(
values = my_colors,
labels = c(
"H2_25" = "25°C",
"H2_32" = "32°C"
)
) +
scale_x_discrete(
labels = c(
"H2_25" = "25°C",
"H2_32" = "32°C"
)
) +
labs(
x = NULL,
y = "Number of lacerates per tub",
color = "Temperature"
) +
my_theme +
theme(
axis.text.x = element_text(
angle = 0,
hjust = 0.5,
vjust = 0.5
)
)
# =========================================================
# PANEL B — FINAL TENTACLE COUNT
# =========================================================
# ---------------------------------------------------------
# 5.5 Extract exact within-cohort p-values
# ---------------------------------------------------------
pvals_tentacles <- pairs(
emm_tentacle,
adjust = "tukey"
) %>%
as.data.frame() %>%
dplyr::select(
cohort,
p.value
)
# ---------------------------------------------------------
# 5.6 Bracket positions
# ---------------------------------------------------------
pvals_tentacles <- pvals_tentacles %>%
left_join(
final_tentacle_dat %>%
group_by(cohort) %>%
summarise(
max_y = max(
tentacle_count,
na.rm = TRUE
),
.groups = "drop"
),
by = "cohort"
) %>%
mutate(
y_bracket = max_y + 1.5,
y_text = max_y + 3,
p_label = format_exact_p(
p.value
)
)
# ---------------------------------------------------------
# 5.7 Panel B — exact p-values
# ---------------------------------------------------------
p_final_tentacles_p <- ggplot(
final_tentacle_dat,
aes(
x = treatment,
y = tentacle_count,
color = treatment
)
) +
geom_boxplot(
outlier.shape = NA,
width = 0.6,
linewidth = 1.2
) +
geom_jitter(
width = 0.15,
size = 2.2,
alpha = 0.65
) +
geom_segment(
data = pvals_tentacles,
aes(
x = 1,
xend = 2,
y = y_bracket,
yend = y_bracket
),
inherit.aes = FALSE,
color = "black",
linewidth = 0.7
) +
geom_segment(
data = pvals_tentacles,
aes(
x = 1,
xend = 1,
y = y_bracket,
yend = y_bracket - 0.7
),
inherit.aes = FALSE,
color = "black",
linewidth = 0.7
) +
geom_segment(
data = pvals_tentacles,
aes(
x = 2,
xend = 2,
y = y_bracket,
yend = y_bracket - 0.7
),
inherit.aes = FALSE,
color = "black",
linewidth = 0.7
) +
geom_text(
data = pvals_tentacles,
aes(
x = 1.5,
y = y_text,
label = p_label
),
inherit.aes = FALSE,
color = "black",
size = 4.2
) +
facet_wrap(
~ cohort,
nrow = 1,
ncol = 5
) +
coord_cartesian(
ylim = c(0, 27),
clip = "off"
) +
scale_color_manual(
values = my_colors,
labels = c(
"H2_25" = "25°C",
"H2_32" = "32°C"
)
) +
scale_x_discrete(
labels = c(
"H2_25" = "25°C",
"H2_32" = "32°C"
)
) +
labs(
x = "Temperature",
y = "Final tentacle count",
color = "Temperature"
) +
my_theme +
theme(
axis.text.x = element_text(
angle = 0,
hjust = 0.5,
vjust = 0.5
),
legend.position = "right",
legend.justification = c(0, 1.4),
legend.box.just = "top"
)
# ---------------------------------------------------------
# 5.8 Combine exact-p Panels A + B
# ONE legend only — supplied by Panel B
# ---------------------------------------------------------
p_lacerate_combined_p <-
(p_lacerates_tub_p + guides(color = "none")) /
p_final_tentacles_p +
plot_layout(
ncol = 1,
heights = c(1, 1)
) +
plot_annotation(
tag_levels = "A"
)
# =========================================================
# SYMBIONT AREA — EXACT P-VALUE VERSION
# =========================================================
# ---------------------------------------------------------
# 5.9 Extract exact 25°C vs 32°C p-value
# ---------------------------------------------------------
pval_symbiont <- pairs(
emm_sym_calc,
adjust = "tukey"
) %>%
as.data.frame() %>%
dplyr::slice(1) %>%
dplyr::select(
p.value
)
# ---------------------------------------------------------
# 5.10 Add bracket position
# ---------------------------------------------------------
symbiont_max <- max(
symbiont_area_well_avg$mean_calculation,
na.rm = TRUE
)
pval_symbiont <- pval_symbiont %>%
mutate(
cohort = factor(
"W7-8",
levels = "W7-8"
),
y_bracket = symbiont_max + 4,
y_text = symbiont_max + 8,
p_label = format_exact_p(
p.value
)
)
